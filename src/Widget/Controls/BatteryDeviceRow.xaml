<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="DeviceBatteryControl.Controls.BatteryDeviceRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" IsTabStop="False">
    <!-- WatchlistRow's exact frame and metrics, with a device in place of a ticker. -->
    <Grid Height="58" Padding="12,0" ColumnSpacing="14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="84" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Rectangle x:Name="Divider" Grid.ColumnSpan="3" Height="1" VerticalAlignment="Top" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="NameText" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxLines="1" />
            <TextBlock x:Name="StateText" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
        </StackPanel>
        <Canvas x:Name="SparkHost" Grid.Column="1" Width="84" Height="28" VerticalAlignment="Center">
            <Canvas.Resources>
                <Style x:Key="SparkLineStyle" TargetType="Polyline"><Setter Property="Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" /></Style>
            </Canvas.Resources>
        </Canvas>
        <StackPanel Grid.Column="2" MinWidth="96" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,0,5,0">
                <FontIcon x:Name="DeviceIcon" FontSize="14" VerticalAlignment="Center" />
                <TextBlock x:Name="PercentageText" FontSize="14" FontWeight="SemiBold" TextLineBounds="Tight" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="BatteryStateText" Margin="0,0,5,0" HorizontalAlignment="Right"
                       Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</UserControl>
