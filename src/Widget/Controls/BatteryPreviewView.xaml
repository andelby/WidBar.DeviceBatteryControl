<UserControl x:Class="DeviceBatteryControl.Controls.BatteryPreviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="TaskbarDeviceIconStyle" TargetType="FontIcon" BasedOn="{StaticResource FluentFontIconStyle}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="PreviewRoot" Margin="10,0" Background="Transparent">
        <Grid x:Name="DevicesPanel" VerticalAlignment="Center" />
        <Grid x:Name="EmptyPanel" ColumnSpacing="8" VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <FontIcon x:Name="EmptyIcon" Glyph="&#xE975;" Style="{StaticResource TaskbarDeviceIconStyle}" />
            <TextBlock x:Name="EmptyText" Grid.Column="1" FontSize="12" MaxLines="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
