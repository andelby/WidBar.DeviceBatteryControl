<UserControl x:Class="DeviceBatteryControl.Controls.BatteryPreviewItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:DefaultBindMode="OneTime" IsTabStop="False"
    ToolTipService.ToolTip="{x:Bind Description}" AutomationProperties.Name="{x:Bind Description}">
    <Grid Width="{x:Bind Metrics.CellWidth}" ColumnSpacing="{x:Bind IconGap}" VerticalAlignment="Center">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <FontIcon x:Name="DeviceIcon" Grid.Column="{x:Bind IconColumn}" Glyph="{x:Bind Glyph}"
                  Visibility="{x:Bind IconVisibility}" FontSize="{x:Bind Metrics.IconSize}"
                  Width="{x:Bind IconExtent}" Height="{x:Bind IconExtent}" VerticalAlignment="Center" />
        <Grid Grid.Column="{x:Bind ContentColumn}" ColumnSpacing="{x:Bind LabelGap}" VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="{x:Bind Label}" Grid.Row="{x:Bind LabelRow}" Grid.Column="{x:Bind LabelColumn}"
                       Visibility="{x:Bind LabelVisibility}" FontSize="{x:Bind Metrics.LabelSize}"
                       LineHeight="{x:Bind LabelLineHeight}" Width="{x:Bind Metrics.LabelWidth}" Opacity="0.72"
                       TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center" />
            <TextBlock x:Name="ValueText" Text="{x:Bind Level}" Grid.Row="{x:Bind ValueRow}" Grid.Column="{x:Bind ValueColumn}"
                       FontSize="{x:Bind Metrics.ValueSize}" LineHeight="{x:Bind ValueLineHeight}" Width="{x:Bind Metrics.ValueWidth}"
                       FontWeight="SemiBold" TextLineBounds="Tight" TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
