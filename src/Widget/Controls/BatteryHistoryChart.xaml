<UserControl x:Class="DeviceBatteryControl.Controls.BatteryHistoryChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="8" ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <Canvas x:Name="GridLines" IsHitTestVisible="False" />
            <Grid x:Name="RevealHost" IsHitTestVisible="False">
                <Canvas x:Name="Plot" SizeChanged="OnSizeChanged" />
            </Grid>
            <TextBlock x:Name="EmptyMessage" FontSize="12" TextWrapping="Wrap" MaxWidth="300"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Canvas x:Name="Overlay" Background="Transparent" PointerMoved="OnPointerMoved"
                    PointerPressed="OnPointerPressed" PointerExited="OnPointerExited">
                <Line x:Name="Cursor" IsHitTestVisible="False" Stroke="{ThemeResource DividerStrokeColorDefaultBrush}" StrokeThickness="1" Visibility="Collapsed" />
                <Ellipse x:Name="CursorDot" IsHitTestVisible="False" Width="9" Height="9" StrokeThickness="1.5"
                         Stroke="{ThemeResource CardBackgroundFillColorDefaultBrush}" Visibility="Collapsed" />
                <Border x:Name="Tooltip" IsHitTestVisible="False" Padding="10,6" CornerRadius="6" BorderThickness="1" Visibility="Collapsed"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="1">
                        <TextBlock x:Name="ValueText" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="TimeText" FontSize="11" Opacity="0.66" />
                    </StackPanel>
                </Border>
            </Canvas>
        </Grid>
        <Grid Grid.Column="1" IsHitTestVisible="False">
            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
            <TextBlock x:Name="Axis0" FontSize="11" Opacity="0.6" HorizontalAlignment="Right" VerticalAlignment="Top" />
            <TextBlock x:Name="Axis1" Grid.Row="1" FontSize="11" Opacity="0.6" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBlock x:Name="Axis2" Grid.Row="2" FontSize="11" Opacity="0.6" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBlock x:Name="Axis3" Grid.Row="3" FontSize="11" Opacity="0.6" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
        <Grid Grid.Row="1">
            <TextBlock x:Name="StartLabel" FontSize="11" Opacity="0.6" />
            <TextBlock x:Name="EndLabel" FontSize="11" Opacity="0.6" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</UserControl>
