<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeviceBatteryControl.Controls.SettingsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <!--
        A Windows 11 settings card, hand-built: icon, header and description,
        then the control. The CommunityToolkit SettingsCard would need its
        resources in the widget process; this keeps its metrics (58 px from the
        edge to the text, 20 px icons) with inbox parts only. See SettingsCard.Placement.
    -->
    <Border x:Name="CardBorder"
            MinHeight="68"
            Padding="16,10"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
        <Grid x:Name="CardGrid" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon x:Name="IconElement"
                      FontSize="20"
                      Margin="2,0,4,0"
                      VerticalAlignment="Center"
                      Visibility="Collapsed" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderText"
                           Style="{StaticResource BodyTextBlockStyle}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="DescriptionText"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <!-- A switch's On/Off, on its left as in Windows Settings. -->
                <TextBlock x:Name="StateText"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
                <ContentPresenter x:Name="ActionPresenter" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
