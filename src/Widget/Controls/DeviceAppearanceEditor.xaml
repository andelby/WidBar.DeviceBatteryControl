<UserControl x:Class="DeviceBatteryControl.Controls.DeviceAppearanceEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeviceBatteryControl.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="IconTemplate" x:DataType="controls:AppearanceIconOption">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Width="20" />
                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="68" Padding="0">
        <Expander.Header>
            <controls:SettingsCard x:Name="Heading" Placement="ExpanderHeader" />
        </Expander.Header>
        <StackPanel Spacing="0">
            <controls:SettingsCard x:Name="IconCard" Placement="ExpanderRow">
                <ComboBox x:Name="IconPicker" MinWidth="200" ItemTemplate="{StaticResource IconTemplate}" SelectionChanged="OnSelectionChanged" />
            </controls:SettingsCard>
            <controls:SettingsCard x:Name="ColorCard" Placement="ExpanderRow">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="ColorMode" MinWidth="160" DisplayMemberPath="Name" SelectionChanged="OnSelectionChanged" />
                    <Button x:Name="CustomColorButton" Width="36" Height="32" Padding="6" Click="OnCustomColorClicked">
                        <Rectangle x:Name="ColorSwatch" Width="16" Height="16" RadiusX="2" RadiusY="2" />
                    </Button>
                </StackPanel>
            </controls:SettingsCard>
            <controls:SettingsCard x:Name="LabelCard" Placement="ExpanderRow">
                <TextBox x:Name="CustomLabel" Width="200" MaxLength="32" TextChanged="OnLabelChanged" />
            </controls:SettingsCard>
        </StackPanel>
    </Expander>
</UserControl>
