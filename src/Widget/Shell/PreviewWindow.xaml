<Window x:Class="DeviceBatteryControl.Shell.PreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowSpacing="8" Padding="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="ThemePicker" SelectionChanged="OnThemeChanged" SelectedIndex="0">
                <ComboBoxItem Content="System" /><ComboBoxItem Content="Light" /><ComboBoxItem Content="Dark" />
            </ComboBox>
            <Button x:Name="SettingsButton" Click="OnSettings" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" MaxHeight="72" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource SectionCardStyle}" Padding="0" Height="48" HorizontalAlignment="Left">
                <ContentControl x:Name="TaskbarContent" VerticalContentAlignment="Stretch" />
            </Border>
        </ScrollViewer>
        <ContentControl x:Name="FlyoutContent" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
