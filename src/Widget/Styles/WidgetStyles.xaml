<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- One Windows 11 icon font for taskbar, device list, flyout and settings. -->
    <Style x:Key="FluentFontIconStyle" TargetType="FontIcon">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="IsTextScaleFactorEnabled" Value="False" />
    </Style>
    <Style TargetType="FontIcon" BasedOn="{StaticResource FluentFontIconStyle}" />
    <!-- Same surfaces, 8px corners and typography as Weather / Stock Watcher. -->
    <Style x:Key="SectionCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,14,16,16" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="SecondaryCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="HeroNumberStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontWeight" Value="SemiLight" />
        <Setter Property="FontSize" Value="52" />
        <Setter Property="TextLineBounds" Value="Tight" />
    </Style>
    <!-- ThemeResource setters stay live when the host changes RequestedTheme. -->
    <Style x:Key="BatteryBarStyle" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    </Style>
    <Style x:Key="LowBatteryBarStyle" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
    </Style>
    <Style x:Key="BatteryRingStyle" TargetType="ProgressRing">
        <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    </Style>
    <Style x:Key="LowBatteryRingStyle" TargetType="ProgressRing">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
    </Style>
    <Style x:Key="LowBatteryTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
    </Style>
    <Style x:Key="ChartLineStyle" TargetType="Polyline">
        <Setter Property="Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    </Style>
    <Style x:Key="ChartDotStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    </Style>
</ResourceDictionary>
