<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeviceBatteryControl.Pages.BatteryFlyoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:DeviceBatteryControl.Pages"
    xmlns:controls="using:DeviceBatteryControl.Controls"
    Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="HeroDeviceIconStyle" TargetType="FontIcon" BasedOn="{StaticResource FluentFontIconStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="HeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16,14,16,16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SectionHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxLines" Value="1" />
        </Style>

        <Style x:Key="SecondaryCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxLines" Value="1" />
        </Style>

        <!-- A favorite in the detail page's strip. The one on show gets the
             accent outline (ActivePillStyle), set in code. -->
        <Style x:Key="PillStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style x:Key="ActivePillStyle" TargetType="Button" BasedOn="{StaticResource PillStyle}">
            <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>

        <!-- A figure in the statistics card: label over value, no frame of
             its own; the card is the frame. -->
        <DataTemplate x:Key="StatCellTemplate" x:DataType="pages:BatteryStatRow">
            <StackPanel>
                <TextBlock Text="{x:Bind Label}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1" />
                <TextBlock Text="{x:Bind Value}"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Background="Transparent" Padding="12,14,0,12" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Margin="0,0,54,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Margin="-9,0,6,0" Visibility="Collapsed"
                    Style="{StaticResource HeaderButtonStyle}" Click="OnBackClicked">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock x:Name="HeaderSubtitle" Style="{StaticResource SecondaryCaptionStyle}" />
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="2" Margin="2,0,0,0"
                    Style="{StaticResource HeaderButtonStyle}" Click="OnRefresh">
                <FontIcon Glyph="&#xE72C;" FontSize="14" RenderTransformOrigin="0.5,0.5">
                    <FontIcon.RenderTransform><RotateTransform x:Name="RefreshIconRotation" /></FontIcon.RenderTransform>
                </FontIcon>
            </Button>
        </Grid>
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto"
                          VerticalScrollMode="Enabled" HorizontalScrollMode="Disabled" Padding="0,0,12,4">
                <StackPanel Spacing="12">
                    <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Warning" IsClosable="False" />
                    <AutoSuggestBox x:Name="SearchBox" MinHeight="36" QueryIcon="Find" TextChanged="OnSearchTextChanged" />
                    <Border x:Name="DevicesSection" Style="{StaticResource SectionCardStyle}" Padding="4,14,4,4">
                        <StackPanel Spacing="6">
                            <Grid Margin="12,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="DevicesHeading" Style="{StaticResource SectionHeadingStyle}" />
                                <TextBlock x:Name="DevicesHint" Grid.Column="1" VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Grid>
                            <ListView x:Name="DeviceList" SelectionMode="None" IsItemClickEnabled="True"
                                      ItemClick="OnDeviceClicked" ScrollViewer.VerticalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListView.ItemContainerTransitions>
                                    <TransitionCollection><AddDeleteThemeTransition /><ReorderThemeTransition /></TransitionCollection>
                                </ListView.ItemContainerTransitions>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                            <StackPanel x:Name="EmptyPanel" Padding="12,24" Spacing="8">
                                <TextBlock x:Name="EmptyTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="EmptyHint" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <HyperlinkButton x:Name="BluetoothSettings" HorizontalAlignment="Center" Click="OnOpenSettings" />
                    <TextBlock x:Name="HomeNote" Margin="0,2,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="DetailPage" x:Load="False" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                          VerticalScrollMode="Enabled" HorizontalScrollMode="Disabled" Padding="0,0,12,4">
                <StackPanel Spacing="12">
                    <ScrollViewer Margin="-2,0" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="PillsPanel" Orientation="Horizontal" Padding="2" Spacing="6" />
                    </ScrollViewer>
                    <Grid x:Name="HeroSection" Padding="0,4,4,6" ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="HeroValue" FontFamily="Segoe UI Variable Display" FontWeight="SemiLight"
                                           FontSize="52" TextLineBounds="Tight" OpticalMarginAlignment="TrimSideBearings" MaxLines="1" />
                                <TextBlock x:Name="HeroUnit" Text="%" Margin="0,0,0,9" VerticalAlignment="Bottom"
                                           Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="HeroStatus" Margin="0,2,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16" LineHeight="22" />
                            <TextBlock x:Name="HeroUpdated" Margin="0,6,0,0" Style="{StaticResource SecondaryCaptionStyle}" />
                        </StackPanel>
                        <FontIcon x:Name="HeroIcon" Grid.Column="1" FontSize="52" Margin="0,0,8,0"
                                  VerticalAlignment="Center" Style="{StaticResource HeroDeviceIconStyle}" />
                    </Grid>
                    <Border x:Name="HistorySection" Style="{StaticResource SectionCardStyle}">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="HistoryHeading" Style="{StaticResource SectionHeadingStyle}" />
                                <TextBlock x:Name="HistoryRange" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SecondaryCaptionStyle}" />
                            </Grid>
                            <controls:BatteryHistoryChart x:Name="HistoryChart" Height="180" />
                            <TextBlock x:Name="HistoryHint" Style="{StaticResource CaptionTextBlockStyle}"
                                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="DetailsSection" Style="{StaticResource SectionCardStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock x:Name="DetailsHeading" Style="{StaticResource SectionHeadingStyle}" />
                            <ItemsRepeater x:Name="DeviceStats" ItemTemplate="{StaticResource StatCellTemplate}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="120" MinRowSpacing="16" MinColumnSpacing="12"
                                                       ItemsStretch="Fill" MaximumRowsOrColumns="3" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="SupportHint" Margin="0,2,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
