<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="DeviceBatteryControl.Pages.BatterySettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:DeviceBatteryControl.Pages"
    xmlns:views="using:DeviceBatteryControl.Controls"
    Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="CardExpanderStyle" TargetType="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="68" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="1,24,0,4" />
        </Style>
        <Style x:Key="CardComboStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
            <Setter Property="MinWidth" Value="200" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Padding="0,0,0,8">
            <Border Padding="16" CornerRadius="{StaticResource ControlCornerRadius}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="LivePreviewHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="LivePreviewNote" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock x:Name="PreviewWidthText" Grid.Column="1" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <Border Grid.Row="1" Height="72" CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{ThemeResource LayerFillColorAltBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <ContentControl x:Name="SampleHost" Height="48" Padding="12,0"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
        <ScrollViewer x:Name="SettingsScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel Spacing="4">
                <TextBlock x:Name="PreviewSectionText" Margin="1,20,0,4" Style="{StaticResource SectionHeaderStyle}" />
                <views:SettingsCard x:Name="CountCard" Glyph="&#xF0E2;">
                    <ComboBox x:Name="PreviewCount" Style="{StaticResource CardComboStyle}" SelectionChanged="OnChanged" />
                </views:SettingsCard>
                <Expander Style="{StaticResource CardExpanderStyle}">
                    <Expander.Header><views:SettingsCard x:Name="DevicesCard" Glyph="&#xE8D2;" Placement="ExpanderHeader" /></Expander.Header>
                    <StackPanel>
                        <views:SettingsCard x:Name="AutomaticCard" Placement="ExpanderRow" ShowDivider="False">
                            <ToggleSwitch x:Name="AutomaticToggle" Toggled="OnAutomaticToggled" />
                        </views:SettingsCard>
                        <StackPanel Margin="48,0,16,12" Spacing="8">
                            <TextBlock x:Name="SelectionCount" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ListView x:Name="DevicePicker" SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="True"
                                      MaxHeight="320" SelectionChanged="OnDeviceSelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="pages:DeviceChoice">
                                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Width="20" />
                                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </StackPanel>
                </Expander>
                <views:SettingsCard x:Name="EmptyCard" Glyph="&#xED1A;">
                    <ToggleSwitch x:Name="EmptyToggle" Toggled="OnToggled" />
                </views:SettingsCard>
                <views:SettingsCard x:Name="ThresholdCard" Glyph="&#xE7BA;">
                    <NumberBox x:Name="Threshold" Width="120" Minimum="5" Maximum="50" SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                </views:SettingsCard>
                <TextBlock x:Name="AppearanceSectionText" Style="{StaticResource SectionHeaderStyle}" />
                <views:SettingsCard x:Name="IconsCard" Glyph="&#xE975;">
                    <ToggleSwitch x:Name="IconsToggle" Toggled="OnToggled" />
                </views:SettingsCard>
                <views:SettingsCard x:Name="LabelModeCard" Glyph="&#xE8D2;">
                    <ComboBox x:Name="LabelModePicker" Style="{StaticResource CardComboStyle}" SelectionChanged="OnChanged" />
                </views:SettingsCard>
                <Expander Style="{StaticResource CardExpanderStyle}">
                    <Expander.Header><views:SettingsCard x:Name="LayoutCard" Glyph="&#xE8A9;" Placement="ExpanderHeader" /></Expander.Header>
                    <StackPanel>
                        <views:SettingsCard x:Name="ArrangementCard" Placement="ExpanderRow" ShowDivider="False">
                            <ComboBox x:Name="ArrangementPicker" Style="{StaticResource CardComboStyle}" SelectionChanged="OnChanged" />
                        </views:SettingsCard>
                        <views:SettingsCard x:Name="DensityCard" Placement="ExpanderRow">
                            <ComboBox x:Name="DensityPicker" Style="{StaticResource CardComboStyle}" SelectionChanged="OnChanged" />
                        </views:SettingsCard>
                        <views:SettingsCard x:Name="ValueSizeCard" Placement="ExpanderRow">
                            <NumberBox x:Name="ValueSizeBox" Width="120" Minimum="10" Maximum="18" SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                        </views:SettingsCard>
                        <views:SettingsCard x:Name="IconPositionCard" Placement="ExpanderRow">
                            <ComboBox x:Name="IconPositionPicker" Style="{StaticResource CardComboStyle}" SelectionChanged="OnChanged" />
                        </views:SettingsCard>
                        <views:SettingsCard x:Name="IconSizeCard" Placement="ExpanderRow">
                            <NumberBox x:Name="IconSizeBox" Width="120" Minimum="12" Maximum="24" SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                        </views:SettingsCard>
                        <views:SettingsCard x:Name="LabelPositionCard" Placement="ExpanderRow">
                            <ComboBox x:Name="LabelPositionPicker" Style="{StaticResource CardComboStyle}" SelectionChanged="OnChanged" />
                        </views:SettingsCard>
                        <views:SettingsCard x:Name="LabelSizeCard" Placement="ExpanderRow">
                            <NumberBox x:Name="LabelSizeBox" Width="120" Minimum="9" Maximum="14" SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                        </views:SettingsCard>
                        <views:SettingsCard x:Name="LabelWidthCard" Placement="ExpanderRow">
                            <NumberBox x:Name="LabelWidthBox" Width="120" Minimum="40" Maximum="160" SmallChange="8" SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                        </views:SettingsCard>
                    </StackPanel>
                </Expander>
                <views:SettingsCard x:Name="PercentCard" Glyph="&#xE94C;">
                    <ToggleSwitch x:Name="PercentToggle" Toggled="OnToggled" />
                </views:SettingsCard>
                <views:SettingsCard x:Name="HighlightCard" Glyph="&#xE7BA;">
                    <ToggleSwitch x:Name="HighlightToggle" Toggled="OnToggled" />
                </views:SettingsCard>
                <views:DeviceAppearanceEditor x:Name="MouseEditor" />
                <views:DeviceAppearanceEditor x:Name="KeyboardEditor" />
                <views:DeviceAppearanceEditor x:Name="HeadphonesEditor" />
                <TextBlock x:Name="DataSectionText" Style="{StaticResource SectionHeaderStyle}" />
                <views:SettingsCard x:Name="DisconnectedCard" Glyph="&#xE702;">
                    <ToggleSwitch x:Name="DisconnectedToggle" Toggled="OnToggled" />
                </views:SettingsCard>
                <views:SettingsCard x:Name="HistoryCard" Glyph="&#xE9D9;">
                    <ToggleSwitch x:Name="HistoryToggle" Toggled="OnToggled" />
                </views:SettingsCard>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,8" Spacing="8">
                    <TextBlock Text="Device Battery Control" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/andelby/WidBar.DeviceBatteryControl" />
                </StackPanel>
                <TextBlock MaxWidth="600" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="8,0,8,12"
                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run x:Name="ForkIntro" /><Hyperlink NavigateUri="https://github.com/krisgfx9/Wireless-Device-Battery-Monitor"><Run Text="Wireless Device Battery Monitor" /></Hyperlink><Run x:Name="ForkThanks" />
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
